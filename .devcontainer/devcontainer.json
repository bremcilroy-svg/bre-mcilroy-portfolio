{
  "name": "Poetry Vault release preview",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Poetry Vault preview",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "(python3 -m http.server 8000 --bind 0.0.0.0 > /tmp/poetry-vault-preview.log 2>&1 &)",
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.startupEditor": "none"
      }
    }
  }
}
